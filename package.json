{
  "name": "lingo-engine-x",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:runtime": "vite build -c vite.runtime.config.ts",
    "seed": "node scripts/generate-seed.mjs",
    "pron": "node scripts/build-pron.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "TZ=Europe/Berlin vitest run",
    "test:e2e": "npm run build && npm run build:runtime && playwright test",
    "check:platform": "node scripts/check-platform.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:e2e && npm run check:platform",
    "grammar:check": "node --experimental-strip-types --no-warnings scripts/grammar/validate.mjs",
    "grammar:build": "node scripts/grammar/build-content.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@xstate/react": "^6.1.0",
    "fflate": "^0.8.3",
    "framer-motion": "^13.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-fsrs": "^5.4.2",
    "xstate": "^5.33.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cmu-pronouncing-dictionary": "3.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright-core": "1.56.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
